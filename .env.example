# ============ MAJBURIY ============
# @BotFather bergan token
BOT_TOKEN=BU_YERGA_TOKEN

# Adminlarning Telegram ID raqamlari (vergul bilan). ID ni @userinfobot dan bilib olasiz
ADMIN_IDS=123456789

# ============ IXTIYORIY ============
# Adminlar guruhi ID si (-100 bilan boshlanadi). Bo'sh bo'lsa, xabarlar har bir adminga shaxsan boradi
ADMIN_GROUP_ID=

# E'lonlar joylanadigan kanal: @kanal_nomi yoki -100... (bot kanalda ADMIN bo'lishi shart)
CHANNEL_ID=

# Kompaniya ma'lumotlari (bot va saytdagi "Aloqa" bo'limlari uchun)
COMPANY_NAME=VOHA UYLARI
COMPANY_PHONE=+998 90 000 00 00
INSTAGRAM_URL=https://instagram.com/voha_uylari
TELEGRAM_CHANNEL_URL=https://t.me/voha_uylari

# ============ SAYT ============
# Saytning ochiq manzili (domen). Bo'sh bo'lsa: http://localhost:8080
WEBSITE_URL=
# Sayt bot bilan birga ishga tushadi (0 — o'chirish)
WEB_ENABLED=1
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Kabinet cookie'lari uchun maxfiy kalit (bo'sh bo'lsa tokendan avtomatik yasaladi)
SECRET_KEY=
# Telegram'dan olingan rasm/videolar keshi
MEDIA_CACHE_DIR=media_cache

# Bitta syomka tannarxi (so'm) — obyekt foydaliligini hisoblash uchun
SHOOTING_COST=350000

# Necha soatda bir baza nusxasi birinchi adminga yuborilsin (0 — o'chirish)
BACKUP_HOURS=24

# Baza fayli
DB_PATH=voha_uylari.db

# Katta yuklama uchun (ixtiyoriy): redis://localhost:6379/0
REDIS_URL=
